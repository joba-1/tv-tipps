# Copy to .env and adjust

# Receivers: name:ip:default_user|priority=N|has_genre=true|wol_mac=XX:XX:XX:XX:XX:XX|power_method=wol|intertechno|none
RECEIVERS_RAW=box15:192.168.1.15:alice|priority=2|wol_mac=00:00:00:00:00:00|power_method=wol,box17:192.168.1.17:bob|priority=1|has_genre=true|power_method=intertechno

USERS_RAW=alice:Alice,bob:Bob

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

POLL_INTERVAL_SEC=45
MIN_WATCH_SEC=300
EPG_FULL_REFRESH_HOUR=3
EPG_RETENTION_DAYS=30
TIMEZONE=Europe/Berlin
PRIME_START_HOUR=20
PRIME_END_HOUR=23

# IntertechnoGateway (mains switch for mains-powered receivers, manual web control only)
# INTERTECHNO_URL=http://intertechnogw
# INTERTECHNO_FAMILY=A
# INTERTECHNO_DEVICE=1

SSH_ENABLED=false
MOCK_RECEIVERS=false
DB_PATH=tv_tips.db
LOG_LEVEL=INFO
